# OpenClaw — Gemini Configuration
# Copy this to .env and completa los valores

# Pre-built image (no build needed)
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# Google Gemini API Key
GEMINI_API_KEY=

# Gateway token — se genera en el primer onboarding
OPENCLAW_GATEWAY_TOKEN=

# Directorios locales para persistencia
OPENCLAW_CONFIG_DIR=./openclaw-config
OPENCLAW_WORKSPACE_DIR=./openclaw-workspace

# Timezone
OPENCLAW_TZ=America/Bogota

# Puertos
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
